                "restaurants",
                "mine"
              ]
            }
          }
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Wood-fired pizza since 1990 \u2014 now with gluten-free crusts\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Menu",
