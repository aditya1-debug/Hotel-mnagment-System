        {
          "name": "Browse Restaurants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants?keyword=&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": ""
